<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: brand gradient from top-left to bottom-right. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/tuit_widget_end"
        android:startColor="@color/tuit_widget_start"
        android:type="linear" />
    <corners android:radius="@dimen/tuit_widget_radius" />
</shape>
