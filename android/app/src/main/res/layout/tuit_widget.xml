<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget "TuitMate · Today" (TuitWidgetProvider). RemoteViews:
     only LinearLayout / FrameLayout / TextView / ImageView here, no plain View.
     The texts below are the preview sample; the provider sets every one of them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tuit_widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Current / next class: takes the free height, clipped first when short. -->
    <LinearLayout
        android:id="@+id/tw_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tw_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tw_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/tuit_widget_brand"
                android:textColor="@color/tuit_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tw_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="@string/tuit_widget_preview_date"
                android:textColor="@color/tuit_widget_text_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tw_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/tuit_widget_pill_now"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/tuit_widget_preview_badge"
            android:textColor="@color/tuit_widget_now_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tw_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/tuit_widget_preview_title"
            android:textColor="@color/tuit_widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tw_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tuit_widget_preview_subtitle"
            android:textColor="@color/tuit_widget_text_soft"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Nearest deadline -->
    <LinearLayout
        android:id="@+id/tw_due_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tw_due_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/tuit_widget_ic_due" />

        <TextView
            android:id="@+id/tw_due_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tuit_widget_preview_due_title"
            android:textColor="@color/tuit_widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tw_due_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="@string/tuit_widget_preview_due_when"
            android:textColor="@color/tuit_widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Classes today | open tasks | NB hours -->
    <LinearLayout
        android:id="@+id/tw_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tuit_widget_panel"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tw_classes_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/tuit_widget_preview_classes_value"
                android:textColor="@color/tuit_widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tw_classes_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tuit_widget_preview_classes_label"
                android:textColor="@color/tuit_widget_text_soft"
                android:textSize="10.5sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="3dp"
            android:background="@color/tuit_widget_divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tw_tasks_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/tuit_widget_preview_tasks_value"
                android:textColor="@color/tuit_widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tw_tasks_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tuit_widget_preview_tasks_label"
                android:textColor="@color/tuit_widget_text_soft"
                android:textSize="10.5sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="3dp"
            android:background="@color/tuit_widget_divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tw_nb_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/tuit_widget_preview_nb_value"
                android:textColor="@color/tuit_widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tw_nb_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tuit_widget_preview_nb_label"
                android:textColor="@color/tuit_widget_text_soft"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
